# Скопируйте этот файл в .env (в той же папке, что и скрипт) и заполните своими данными.
# Файл .env никогда не выкладывайте в git / общие папки — там будет пароль в открытом виде.

EWS_EMAIL=secretary@enremservice.ru
EWS_USERNAME=secretary@enremservice.ru
EWS_PASSWORD=<реальный пароль>
EWS_SERVER=mail.lancloud.ru
TZ=Europe/Moscow
FIREFLIES_API_KEY=<реальный ключ>
